<Window x:Class="ShearWallVisualizer.Dialogs.LoadInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShearWallVisualizer.Dialogs"
        xmlns:ctrl="clr-namespace:ASCE7WindLoadCalculator;assembly=ASCE7WindLoadCalculator"
        mc:Ignorable="d"
        Title="Enter Load Information" SizeToContent="WidthAndHeight">
    <StackPanel Orientation="Horizontal">
        <StackPanel Orientation="Vertical">
            <Button x:Name="btnManual" Content="Manual" Width="75" Height="25" Margin="5" Click="btnManual_Click"/>
            <Button x:Name="btnASCEWind" Content="ASCE Wind" Width="75" Height="25" Margin="5" Click="btnASCEWind_Click"/>
        </StackPanel>
        <StackPanel Orientation="Vertical">
            <Grid Name="gridManual" Margin="10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Direction X -->
                <TextBlock Text="Load Magnitude (kips) X:" Grid.Row="0" Grid.Column="0" Margin="5"/>
                <TextBox x:Name="MagnitudeXBox" Grid.Row="0" Grid.Column="1" Margin="5"/>

                <!-- Direction Y -->
                <TextBlock Text="Load Magnitude (kips) Y:" Grid.Row="2" Grid.Column="0" Margin="5"/>
                <TextBox x:Name="MagnitudeYBox" Grid.Row="2" Grid.Column="1" Margin="5"/>

            </Grid>
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Vertical" Name="gridASCEWind" Margin="10" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <ctrl:BuildingDataInputControl x:Name="ctrBuildingDataInputControl" Margin="5"/>
                        <ctrl:WindLoadInputControl x:Name="ctrlWindLoadInputControl" Margin="5"  />
                    </StackPanel>
                    <CheckBox x:Name="cbOnlyCases1And3" Margin="5" Checked="LoadCaseOption_Changed" Unchecked="LoadCaseOption_Changed"
                              Content="Use only Load Cases 1 and 3 (ASCE 7 Fig. 27.3-8 exception)"
                              ToolTip="Allowed for one-story buildings with h &lt;= 30 ft, and for buildings of two stories or less that are light-frame or have flexible diaphragms. Otherwise all four cases, including the torsional cases 2 and 4, are required."/>
                    <TextBlock x:Name="tbWindLoadSummary" Margin="5" TextWrapping="Wrap" MaxWidth="900"/>
                </StackPanel>
            </StackPanel>
            <!-- Buttons -->
            <StackPanel Name="stackPanelButtons" Visibility="Collapsed" Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                <Button Content="OK" Width="75" Margin="5" Click="OkButton_Click"/>
                <Button Content="Cancel" Width="75" Margin="5" Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>

    </StackPanel>
</Window>
