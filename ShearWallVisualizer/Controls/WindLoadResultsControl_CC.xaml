<UserControl x:Class="ShearWallVisualizer.Controls.WindLoadResultsControl_CC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ShearWallVisualizer.Controls"
             mc:Ignorable="d" 
             >
    <Border>
        <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Horizontal" Background="AliceBlue">
                <TextBlock x:Name="tbVersion" Text="VERSION XXX" FontSize="18" FontWeight="Bold" Width="Auto"/>
                <TextBlock Text="  Components and Cladding Results" FontWeight="Bold" FontSize="18" Width="Auto"/>
            </StackPanel>
            <Grid Margin="10" Background="LightBlue">
                <!-- Define Grid Layout -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <!-- Results Controls (Right Column) -->
                    <StackPanel Name="spResultsAndCanvas" Grid.Row="0" Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left" Margin="10">
                        <!-- Importance Factor -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="qh (psf) = " VerticalAlignment="Center" />
                            <TextBlock Name="tbl_qh" Width="150"  Text=""/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock Text="h (ft) = " VerticalAlignment="Center"/>
                                <TextBlock Name="tbl_h" Width="150" Text=""/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock Text="theta (deg) = " VerticalAlignment="Center" />
                                <TextBlock Name="tbl_theta" Width="150"  Text=""/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock Text="h/L = " VerticalAlignment="Center"/>
                                <TextBlock Name="tbl_hOverL" Width="150" Text=""/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="h/B = " VerticalAlignment="Center"/>
                                <TextBlock Name="tbl_hOverB" Width="150" Text=""/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Display Results of MWFRS Calculation -->
                        <TextBlock Text="Results (Comp. And Clad.)" Margin="10"/>
                        <DataGrid x:Name="WallResultsDataGrid" 
                  AutoGenerateColumns="True"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                      Width="Auto"
                      Height="Auto"
                      FontSize="10">
                        </DataGrid>

                        <!-- Display Roof Zone Pressure Results -->
                        <TextBlock Text="Roof Zone Pressures" Margin="10"/>
                        <DataGrid x:Name="RoofResultsDataGrid"
                  AutoGenerateColumns="True"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                      Width="Auto"
                      Height="Auto"
                      FontSize="10">
                        </DataGrid>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Grid.Column="1" Margin="5">
                        <Canvas x:Name="cnvWindLoadResultCanvasCC" Width="200" Height="200" Background="Transparent"></Canvas>

                        <!-- Ae vs GCp coefficient curve-->
                        <StackPanel Orientation="Vertical" Margin="0 15 0 0">
                            <TextBlock x:Name="txtFigureTitle" Text="Title" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"  />
                            <Canvas x:Name="cnvFigure30_3" Width="200" Height="200" Background="White"></Canvas>
                            <TextBlock x:Name="txtFigureCriteria" Text="Criteria" Height="25" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
