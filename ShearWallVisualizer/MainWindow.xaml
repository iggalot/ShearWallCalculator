<Window x:Class="ShearWallVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShearWallVisualizer"
        xmlns:ctrl="clr-namespace:ShearWallVisualizer.Controls"
        xmlns:sketch="clr-namespace:BuildingModel.Sketch;assembly=BuildingModel.Sketch"
        mc:Ignorable="d"
        Title="Rigid Diaphragm Shear Wall Calculator v0.1" Height="900" Width="1600" MinHeight="600" MinWidth="1000" WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Background="#F7F8FA" FontFamily="Segoe UI"
        >

    <DockPanel>

        <!-- Menu Bar at the very top -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New project..." Click="MenuItem_New_Click" InputGestureText="Ctrl+N"
                          ToolTip="Pick a folder for the project, then the building's size; the model, reports and logs are kept in that folder"/>
                <MenuItem Header="_Open project..." Click="MenuItem_Load_Click" InputGestureText="Ctrl+O"
                          ToolTip="A building model (.bldg.json); its folder becomes the project folder"/>
                <MenuItem Header="_Save" Click="MenuItem_Save_Click" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save _As (a copy in another folder)..." Click="MenuItem_SaveAs_Click"/>
                <Separator/>
                <MenuItem Header="Open _Recent" x:Name="RecentFilesMenu"/>
                <Separator/>
                <MenuItem Header="_Print report..." Click="MenuItem_PrintReport_Click" InputGestureText="Ctrl+P"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Refresh" Click="Refresh_Click"/>
                <MenuItem Header="3D _Wind View (window)" Click="Open3DWindWindow_Click"/>
                <MenuItem Header="_Hold-down catalog (values used by the design)" Click="OpenHoldownCatalog_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Click="Undo_Click" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="_Redo" Click="Redo_Click" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="_Move" Click="btnMove_Click" InputGestureText="M"/>
                <MenuItem Header="_Copy" Click="btnCopy_Click" InputGestureText="C"/>
                <MenuItem Header="_Delete" Click="Delete_Click" InputGestureText="Del"/>
                <Separator/>
                <MenuItem x:Name="miCopyFromBelow" Header="Copy the level _below onto this level" Click="CopyFromBelow_Click"/>
                <MenuItem Header="Mea_sure distance" Click="btnMeasure_Click" InputGestureText="T"/>
                <MenuItem Header="_Note on the plan" Click="btnNote_Click" InputGestureText="N"/>
                <MenuItem Header="Cu_t from the diaphragms (notch, L, courtyard)" Click="btnCut_Click" InputGestureText="K"/>
                <Separator/>
                <MenuItem Header="_Ortho (move, copy, measure)" Click="btnOrtho_Click" InputGestureText="F8"/>
                <MenuItem Header="_Zoom to the drawing" Click="btnZoomExtents_Click" InputGestureText="Z"/>
                <Separator/>
                <MenuItem Header="Plans: import or place them in the Building Model editor..." Click="EditBuilding_Click"/>
            </MenuItem>
            <MenuItem Header="_Model">
                <MenuItem Header="_3D view of the building" Click="Show3D_Click"/>
                <MenuItem Header="_Check the model (errors and warnings)" Click="CheckModel_Click"/>
                <Separator/>
                <MenuItem Header="_Edit building in the Building Model editor..." Click="EditBuilding_Click"
                          ToolTip="Saves the project and opens it in the Building Model editor: the levels, size and roof are edited there. This window updates each time the editor saves."/>
                <Separator/>
                <MenuItem Header="_Export changes since opened..." Click="ExportChanges_Click"
                          ToolTip="What was added, moved or deleted since the project was opened or saved, as a change set another copy of the model can apply"/>
                <MenuItem Header="_Apply a change set..." Click="ApplyChanges_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Open _log folder" Click="OpenLogFolder_Click"/>
                <MenuItem Header="_Two-face sheathing rule..." Click="TwoFaceRule_Click"/>
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Workspace switch: the two halves of the job. Wind loads (guided setup, 3D, detailed tables)
             feed Shear walls (drawing canvas, dimensions, per-wall results). -->
        <Border DockPanel.Dock="Top" Background="#FCFCFB" BorderBrush="#E1E0D9" BorderThickness="0,0,0,1" Padding="10,6">
            <Border.Resources>
                <Style x:Key="Workspace" TargetType="RadioButton">
                    <Setter Property="Margin" Value="0,0,6,0"/>
                    <Setter Property="Padding" Value="18,7"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Foreground" Value="#0B0B0B"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="bd" CornerRadius="6" BorderThickness="1" BorderBrush="#C3C2B7" Background="White" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#898781"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#0B0B0B"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#0B0B0B"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>
            <DockPanel>
                <RadioButton x:Name="rbWorkspaceWind" GroupName="workspace" Style="{StaticResource Workspace}" IsChecked="True"
                             Content="1   Wind loads" Checked="Workspace_Checked"
                             ToolTip="Site, building and wind results (ASCE 7). These loads go to the shear walls automatically."/>
                <RadioButton x:Name="rbWorkspaceWalls" GroupName="workspace" Style="{StaticResource Workspace}"
                             Content="2   Shear walls" Checked="Workspace_Checked"
                             ToolTip="Draw the walls and diaphragms, and see the force on each wall."/>
                <TextBlock x:Name="tbWorkspaceLoads" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#52514E"/>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <!-- Rows: toolbar, drawing + tabs (fills the window), status line -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Toolbar with Buttons -->
            <!-- Drawing tools. A tool button is lit (Tag="on") while its tool or display is active. -->
            <Border x:Name="spDrawingToolbar" Grid.Row="0" Background="#FCFCFB" BorderBrush="#E1E0D9" BorderThickness="0,0,0,1" Padding="10,5">
                <Border.Resources>
                    <Style x:Key="Tool" TargetType="Button">
                        <Setter Property="Margin" Value="0,0,4,0"/>
                        <Setter Property="Padding" Value="11,4"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Foreground" Value="#0B0B0B"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="5" BorderThickness="1" BorderBrush="#C3C2B7" Background="White" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#898781"/>
                                        </Trigger>
                                        <Trigger Property="Tag" Value="on">
                                            <Setter TargetName="bd" Property="Background" Value="#E6F0FB"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#2A78D6"/>
                                            <Setter Property="Foreground" Value="#0B4C9A"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="ToolGroup" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#7A7974"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,0,6,0"/>
                    </Style>
                    <Style x:Key="ToolDivider" TargetType="Rectangle">
                        <Setter Property="Width" Value="1"/>
                        <Setter Property="Fill" Value="#E1E0D9"/>
                        <Setter Property="Margin" Value="8,2,10,2"/>
                    </Style>
                </Border.Resources>
                <DockPanel>
                    <WrapPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <!-- Multi-story (Floors in the building inputs): which level the plan shows and edits -->
                        <StackPanel x:Name="levelGroup" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolGroup}" Text="LEVEL"/>
                            <Button x:Name="btnFoundation" Style="{StaticResource Tool}" Content="Foundation" Padding="9,4" Click="Foundation_Click"
                                    ToolTip="FOUNDATION: the ground plan with every hold-down anchor of the first story's walls (wall, model, uplift), for the foundation design. Pick a level to edit walls again."/>
                            <Button x:Name="btnLevel1" Style="{StaticResource Tool}" Content="1" Padding="9,4" CommandParameter="1" Click="LevelButton_Click"/>
                            <Button x:Name="btnLevel2" Style="{StaticResource Tool}" Content="2" Padding="9,4" CommandParameter="2" Click="LevelButton_Click"/>
                            <Button x:Name="btnLevel3" Style="{StaticResource Tool}" Content="3" Padding="9,4" CommandParameter="3" Click="LevelButton_Click"/>
                            <!-- floors are the building's geometry: added and deleted only in the Building Model editor -->
                            <Button x:Name="btnFloors" Style="{StaticResource Tool}" Content="Floors…" Click="EditBuilding_Click"
                                    ToolTip="FLOORS: added, deleted and given their plate heights in the Building Model editor; this opens it on the project."/>
                            <Rectangle Style="{StaticResource ToolDivider}"/>
                        </StackPanel>
                        
                        <TextBlock Style="{StaticResource ToolGroup}" Text="LOADS"/>
                        <Button x:Name="btnLoadEntry" Style="{StaticResource Tool}" Content="Loads..." Click="btnOpenLoadDialog_Click"
                                ToolTip="Use the wind loads (automatic) or enter loads by hand"/>
                        <TextBlock x:Name="LoadInfoTextBlock" VerticalAlignment="Center" Margin="2,0,0,0" FontSize="13" Foreground="#52514E"/>
                        <Rectangle Style="{StaticResource ToolDivider}"/>
                        <TextBlock Style="{StaticResource ToolGroup}" Text="SHOW"/>
                        <Button x:Name="btnHideImage" Style="{StaticResource Tool}" Content="Image" Tag="on" Click="btnHideImage_Click"
                                ToolTip="Show or hide the plan under this level (on this screen only; the plan is the building model's)"/>
                        <Button x:Name="btnImageOptions" Style="{StaticResource Tool}" Content="▾" Padding="6,4" Click="btnImageOptions_Click"
                                ToolTip="Plan: show or hide, zoom to it; plans are imported and placed in the Building Model editor"/>
                        <Button x:Name="btnShowDesign" Style="{StaticResource Tool}" Content="Design" Tag="on" Click="btnShowDesign_Click"
                                ToolTip="Shear wall marks (SW1, SW2, ...) with each wall's hold-down, the hold-downs at the wall ends, and the shear wall schedule"/>
                        <Button x:Name="btnLoads" Style="{StaticResource Tool}" Content="Loads" Click="btnLoads_Click"
                                ToolTip="One load case on the plan: the shear each wall of the level above puts into this floor (orange) and what the top of each wall here receives (blue). Pick the case with ▾ or on the Calculations tab"/>
                        <Button x:Name="btnLoadsOptions" Style="{StaticResource Tool}" Content="▾" Padding="6,4" Click="btnLoadsOptions_Click"
                                ToolTip="The load case the Loads overlay shows"/>
                        <Button x:Name="btn3D" Style="{StaticResource Tool}" Content="3D" Click="Show3D_Click"
                                ToolTip="The building in 3D from the model: every level's diaphragm and the walls (shear walls blue); the level shown is stronger"/>
                        <Button x:Name="btnIssues" Style="{StaticResource Tool}" Content="✓" Click="Issues_Click"
                                ToolTip="Errors and warnings in the model and the design (also marked on the plan)"/>
                    </WrapPanel>
                    <TextBlock x:Name="tbImageFileName" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="#7A7974" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- Main Drawing + Right-side Tabs -->
            <Grid Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="drawingColumn" Width="750" MinWidth="400"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="480"/>
                </Grid.ColumnDefinitions>

                <!-- Drawing Area: the full height under the toolbar; drag the bar on its right to widen it -->
                <DockPanel x:Name="dockpanel" Grid.Column="0" LastChildFill="True" ClipToBounds="True" Background="White">
                    <!-- The shared sketcher (BuildingModel.Sketch): its own tools, snaps, undo and status line; the building model is the source of truth -->
                    <sketch:SketchView x:Name="sketchView"/>
                </DockPanel>

                <!-- The picked wall or diaphragm (Select tool), over the top-right corner of the drawing -->
                <ctrl:SelectionCard x:Name="selectionCard" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Visibility="Collapsed"/>

                <GridSplitter x:Name="drawingSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Background="Transparent" Cursor="SizeWE"
                              ToolTip="Drag to make the drawing wider or narrower"/>

                <!-- Dynamic Tabs -->
                <TabControl x:Name="MainTabControl" Grid.Column="2"
                            TabStripPlacement="Top" Margin="2 0 0 0"
                            SelectionChanged="MainTabControl_SelectionChanged">
                    <!-- Building Data control -->
                    <!-- Guided wind input (Site, Building, Results); the classic BuildingData and WIND Input tabs stay in sync with it -->
                    <TabItem x:Name="tabWindSetupTabItem" Width="100" HorizontalAlignment="Center" Header="Wind Setup" Margin="5 0 5 0"/>

                    <!-- Every coefficient, table and graph behind the wind results; replaces CC Wind Calcs / MWFRS 1 / MWFRS 2 -->
                    <TabItem x:Name="tabWindDetailsTabItem" Width="150" HorizontalAlignment="Center" Header="Detailed calculations" Margin="5 0 5 0"/>

                    <TabItem x:Name="tabBuildingDataControlTabItem" Width="100" HorizontalAlignment="Center" Header="BuildingData" Margin="5 0 5 0"/>
                    
                    <!-- Walls and diaphragms with typed coordinates (GeometryPanel) -->
                    <TabItem x:Name="tabDimensionsTabItem" Header="Members" Width="140" ToolTip="Every wall, diaphragm, beam and column, on every level" HorizontalAlignment="Center" Margin="5 0 5 0"/>

                    <!-- Wind Input control-->
                    <TabItem Header="WIND Input" x:Name="tabWindInputControlTabItem" Width="100" HorizontalAlignment="Center" Margin="5 0 5 0" />

                    <TabItem x:Name="tabWindResultsTabItem_MWFRS_BldgLength" Header="MWFRS 1" Width="100" HorizontalAlignment="Center" Margin="5 0 5 0" />
                    <TabItem x:Name="tabWindResultsTabItem_MWFRS_BldgWidth" Header="MWFRS 2" Width="100" HorizontalAlignment="Center" Margin="5 0 5 0" />

                    <TabItem x:Name="tabWindResultsTabItem_CC"  Header="CC Wind Calcs" Width="100" HorizontalAlignment="Center" Margin="5 0 5 0" />

                    <TabItem x:Name="tabWind3DTabItem" Header="3D Wind" Width="100" HorizontalAlignment="Center" Margin="5 0 5 0" />

                    <!-- How the load is shared among the walls (ShearResultsPanel) -->
                    <TabItem x:Name="tabCalculationsTabItem" Header="Calculations" Width="100" HorizontalAlignment="Center" Margin="5 0 5 0"/>

                    <!-- Sheathing, nailing and hold-down checks for each wall (SDPWS; Simpson hold-downs) -->
                    <TabItem x:Name="tabDesignTabItem" Header="Design" Width="100" HorizontalAlignment="Center" Margin="5 0 5 0"/>

                </TabControl>

                <!-- Optional Logging + Scroll -->
                <!--
                <TextBlock Name="m_log" Height="600" Width="150" Margin="10 0 0 0"/>
                <ScrollBar Name="m_scroll" MaxHeight="600" Scroll="OnScroll" Orientation="Vertical"/>-->
            </Grid>
            <!-- Info Labels -->
            <!-- Status line: what the drawing tool expects next, cursor position, zoom; the latest warning or error from the log on the right -->
            <Border Grid.Row="2" Background="#FCFCFB" BorderBrush="#E1E0D9" BorderThickness="0,1,0,0" Padding="10,3">
                <DockPanel>
                    <TextBlock x:Name="tbStatusMessage" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Cursor="Hand"
                               MouseLeftButtonUp="StatusMessage_Click" ToolTip="Click to open the log folder"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
