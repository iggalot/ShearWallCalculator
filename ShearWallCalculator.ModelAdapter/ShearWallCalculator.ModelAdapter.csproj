<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The shared building model <-> the Shear Wall Designer's per-level calculators. The designer reads the model and
    writes what it draws (walls, diaphragms) and designs back into it; the model knows nothing of shear walls.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ShearWallCalculator.ModelAdapter</RootNamespace>
    <AssemblyName>ShearWallCalculator.ModelAdapter</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingModel\BuildingModel.Core\BuildingModel.Core.csproj" />
    <ProjectReference Include="..\ShearWallCalculator.csproj" />
    <!-- a first-story shear wall's sill bolts (SillAnchorage), in the design it saves for the wall views of every app -->
    <ProjectReference Include="..\..\WoodFraming\WoodFraming\WoodFraming.csproj" />
    <!-- the connections it designs (sills, diaphragm lines) and their defaults: details, not the building model's -->
    <ProjectReference Include="..\..\WoodFraming\WoodFraming.Connections\WoodFraming.Connections.csproj" />
    <ProjectReference Include="..\..\NDS_WoodLibrary\NDS_WoodLibrary.csproj" />
    <!-- the wind calculator's own wind cases, for the headless check (ShearWallCheck) -->
    <ProjectReference Include="..\..\ASCE7-Wind-Load-Calculator\ASCE7Wind.ModelAdapter\ASCE7Wind.ModelAdapter.csproj" />
    <ProjectReference Include="..\..\ASCE7-Wind-Load-Calculator\ASCE7Wind.Core\ASCE7Wind.Core.csproj" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <!-- the designer's own copy (no download) -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\packages\Newtonsoft.Json.13.0.3\lib\net45\Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
